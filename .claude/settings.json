{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "Agent(*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo \"[$(date '+%Y-%m-%d %H:%M')] [desktop:main] Session ended\" >> \"10_Command Center/[AGENT_NAME] Activity Log.md\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
